{
  "name": "browser-use",
  "version": "1.0.0",
  "description": "Use the user's Edge or Chrome browser through MyCodex's browser automation tool.",
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "Interrupt": [{ "hooks": [{ "type": "mcp_tool", "server": "cua_repl", "tool": "turn_ended", "input": { "hook_event_name": "${hook_event_name}", "session_id": "${session_id}", "turn_id": "${turn_id}" } }] }],
      "SubagentStop": [{ "hooks": [{ "type": "mcp_tool", "server": "cua_repl", "tool": "turn_ended", "input": { "hook_event_name": "${hook_event_name}", "session_id": "${agent_id}", "turn_id": "${turn_id}" } }] }],
      "Stop": [{ "hooks": [{ "type": "mcp_tool", "server": "cua_repl", "tool": "turn_ended", "input": { "hook_event_name": "${hook_event_name}", "session_id": "${session_id}", "turn_id": "${turn_id}" } }] }]
    }
  }
}
