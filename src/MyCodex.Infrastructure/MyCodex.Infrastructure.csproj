<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MyCodex.Infrastructure</RootNamespace>
    <AssemblyName>Infrastructure</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyCodex.Application\MyCodex.Application.csproj" />
    <ProjectReference Include="..\MyCodex.Domain\MyCodex.Domain.csproj" />
    <ProjectReference Include="..\MyCodex.Shared\MyCodex.Shared.csproj" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\runtime\computer-use-bundle.json">
      <LogicalName>MyCodex.ComputerUse.BundlePin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\runtime\browser-use-bundle.json">
      <LogicalName>MyCodex.BrowserUse.BundlePin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\runtime\browser-extension-host.json">
      <LogicalName>MyCodex.BrowserUse.ExtensionHostPin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="BrowserUse\PluginAssets\.agents\plugins\marketplace.json">
      <LogicalName>MyCodex.BrowserUse.PluginMarketplace</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="BrowserUse\PluginAssets\plugins\browser-use\.codex-plugin\plugin.json">
      <LogicalName>MyCodex.BrowserUse.PluginManifest</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="BrowserUse\PluginAssets\plugins\browser-use\skills\browser-use\SKILL.md">
      <LogicalName>MyCodex.BrowserUse.PluginSkill</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
